       },
       {
        "type": "null"
       }
      ],
      "title": "Decided At"
     },
     "decided_by": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Decided By"
     },
     "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
