   "InvestigationResult": {
    "additionalProperties": false,
    "description": "Structured, evidence-backed root cause with a confidence score.",
    "properties": {
     "case_id": {
      "format": "uuid",
      "title": "Case Id",
      "type": "string"
     },
     "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
     },
     "evidence": {
      "items": {
       "$ref": "#/components/schemas/Evidence"
      },
      "title": "Evidence",
      "type": "array"
     },
     "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
     },
     "proposed_fix": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/ProposedFix"
       },
       {
        "type": "null"
       }
      ]
     },
     "reason_category": {
      "$ref": "#/components/schemas/ReasonCategory"
     },
     "reasoning_trace_id": {
      "minLength": 1,
      "title": "Reasoning Trace Id",
      "type": "string"
     },
     "root_cause": {
      "minLength": 1,
      "title": "Root Cause",
      "type": "string"
     },
     "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
     },
     "tokens_used": {
      "minimum": 0.0,
      "title": "Tokens Used",
      "type": "integer"
     }
    },
    "required": [
     "schema_version",
     "case_id",
     "root_cause",
     "reason_category",
     "evidence",
     "proposed_fix",
     "confidence",
     "model",
     "tokens_used",
     "reasoning_trace_id"
    ],
    "title": "InvestigationResult",
    "type": "object"
