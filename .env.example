# Copy to .env and fill in. Every variable the system reads is documented here.

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=settlement.failures
KAFKA_DLQ_TOPIC=settlement.failures.dlq
KAFKA_GROUP_ID=settleagent

# PostgreSQL
DATABASE_URL=postgresql+psycopg://settleagent:settleagent@localhost:5432/settleagent

# Claude API (required for the real agent and evals; mocked in tests)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_MAX_TOKENS=4096

# Control-plane API key (min 16 chars)
API_KEY=change-me-change-me

# Policy / limits
AUTO_THRESHOLD=0.9
MAX_STEPS=12
MAX_ANALYZE_ROUNDS=2
DEGRADED_CONFIDENCE_CAP=0.6
MAX_INFLIGHT_CASES=8
COST_CEILING_USD=50

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# /ready also requires the OTel collector to be reachable; set false to make it optional
READY_REQUIRES_OTEL=true
OTEL_ENABLED=true
OTEL_METRIC_INTERVAL_MS=10000
LOG_LEVEL=INFO
LOG_JSON=true
# Alerts: one case costing more than this, or total spend reaching 80%/100% of COST_CEILING_USD
PER_CASE_COST_ALERT_USD=1.0
BUDGET_WARN_FRACTION=0.8

# MCP tool servers (streamable HTTP)
MCP_SECURITY_MASTER_URL=http://localhost:8101/mcp
MCP_SSI_STORE_URL=http://localhost:8102/mcp
MCP_HOLIDAY_CALENDAR_URL=http://localhost:8103/mcp
MCP_TRADE_STORE_URL=http://localhost:8104/mcp
TOOL_TIMEOUT_S=10
TOOL_MAX_ATTEMPTS=3
TOOL_BACKOFF_S=0.2
BREAKER_THRESHOLD=5
BREAKER_COOLDOWN_S=30

# Ops dashboard (reads API_KEY above unless SETTLE_API_KEY is set)
SETTLE_API_URL=http://localhost:8000
# Link template to your tracing UI (default shown; Jaeger runs in docker compose):
TRACE_URL_TEMPLATE=http://localhost:16686/trace/{trace_id}
